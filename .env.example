# AI-Commerce — environment variable reference
#
# This file documents every variable used across the monorepo. It is the template —
# copy the values you need into apps/api/.env and apps/web/.env.local (both gitignored)
# to run locally. See docs/DEVELOPMENT.md for the full setup guide.
#
# Never commit real secrets. .env.development and .env.test in this same folder are safe
# to commit because they only ever point at local/ephemeral resources — .env.production
# is never committed; only a .example template is.

NODE_ENV=development

# --- API (apps/api) ---
PORT=4000
WEB_ORIGIN=http://localhost:3000
DATABASE_URL=postgresql://ai_commerce:ai_commerce_dev@localhost:5432/ai_commerce?schema=public
# Phase 14 — Neon's pooled connection (DATABASE_URL) vs. direct/unpooled (DIRECT_URL):
# `prisma migrate` needs a direct session, serverless query traffic needs the pooler.
# Locally there's no pooler at all, so both point at the same plain Postgres connection.
DIRECT_URL=postgresql://ai_commerce:ai_commerce_dev@localhost:5432/ai_commerce?schema=public
REDIS_URL=redis://localhost:6379

# Generate with: openssl rand -hex 32
JWT_ACCESS_SECRET=
JWT_ACCESS_TTL=15m
JWT_REFRESH_SECRET=
JWT_REFRESH_TTL_DAYS=30

# --- Web (apps/web) ---
NEXT_PUBLIC_API_URL=http://localhost:4000/api/v1

# --- Mobile (apps/mobile) ---
EXPO_PUBLIC_API_URL=http://localhost:4000/api/v1

# --- Introduced in later phases (documented now so nothing is ever hard-coded later) ---
# ANTHROPIC_API_KEY=        # Phase 9 — ShopAI (Anthropic Messages API, tool calling)
# PAYMENT_SECRET=           # Webhook HMAC secret, verified even by the dev adapter (Phase 12) — unset rejects every webhook
# STORAGE_BUCKET=           # Phase 2 — product image uploads
# (Phase 8 resolved: pgvector runs directly on DATABASE_URL, no separate VECTOR_DATABASE_URL needed)
