# AI-Commerce — environment variable reference
#
# This file documents every variable used across the monorepo. It is the template —
# copy the values you need into apps/api/.env and apps/web/.env.local (both gitignored)
# to run locally. See docs/DEVELOPMENT.md for the full setup guide.
#
# Never commit real secrets. .env.development and .env.test in this same folder are safe
# to commit because they only ever point at local/ephemeral resources — .env.production
# is never committed; only a .example template is.

NODE_ENV=development

# --- API (apps/api) ---
PORT=4000
# Comma-separated allow-list, not a single origin — local dev needs more than one (see
# .env.development's comment).
WEB_ORIGIN=http://localhost:3000,http://localhost:3100
DATABASE_URL=postgresql://ai_commerce:ai_commerce_dev@localhost:5432/ai_commerce?schema=public
# Phase 14 — Neon's pooled connection (DATABASE_URL) vs. direct/unpooled (DIRECT_URL):
# `prisma migrate` needs a direct session, serverless query traffic needs the pooler.
# Locally there's no pooler at all, so both point at the same plain Postgres connection.
DIRECT_URL=postgresql://ai_commerce:ai_commerce_dev@localhost:5432/ai_commerce?schema=public
REDIS_URL=redis://localhost:6379

# Embeddings: hashing is local and the default; 'openai' enables the hosted
# text-embedding-3-small provider after running the product reindex backfill.
EMBEDDING_PROVIDER=hashing
# OPENAI_API_KEY=         # Required only when EMBEDDING_PROVIDER=openai

# Generate with: openssl rand -hex 32
JWT_ACCESS_SECRET=
JWT_ACCESS_TTL=15m
JWT_REFRESH_SECRET=
JWT_REFRESH_TTL_DAYS=30

# --- Web (apps/web) ---
NEXT_PUBLIC_API_URL=http://localhost:4000/api/v1
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# Optional offline showcase/CI build switch. Keep unset or false for production;
# production builds must use the deployed API's real catalog.
# NEXT_PUBLIC_ALLOW_DEMO_FALLBACK=true

# --- Mobile (apps/mobile) ---
EXPO_PUBLIC_API_URL=http://localhost:4000/api/v1
# Product image URLs from apps/api are relative paths served by apps/web's own /public
# static files (no separate image CDN) — mobile has no origin of its own to resolve them
# against, so it needs apps/web's base URL explicitly.
EXPO_PUBLIC_WEB_URL=http://localhost:3000

# --- AI and operational settings ---
ANTHROPIC_API_KEY=          # Required by the API boot preflight for ShopAI
# ANTHROPIC_MODEL=          # Optional; defaults to the configured Anthropic model
# PAYMENT_SECRET=           # Webhook HMAC secret, shared by whichever payment provider is active — unset rejects every webhook
# Product media is URL/path-only today; no STORAGE_BUCKET is read by apps/api yet.
# (Phase 8 resolved: pgvector runs directly on DATABASE_URL, no separate VECTOR_DATABASE_URL needed)

# --- Real payment provider (apps/api + apps/web) ---
# PAYMENT_PROVIDER=development   # 'development' | 'razorpay' — unset defaults to the simulated dev adapter; invalid values fail preflight
# RAZORPAY_KEY_ID=                # From the Razorpay dashboard's API Keys section (test or live mode)
# RAZORPAY_KEY_SECRET=            # Same source — never exposed client-side
# NEXT_PUBLIC_RAZORPAY_KEY_ID=    # apps/web — must be set together with the backend vars above; unset keeps checkout on the simulated (instant-confirm) path
# EXPO_PUBLIC_RAZORPAY_KEY_ID=    # apps/mobile — same key, same gating; unset keeps checkout on the simulated (instant-confirm) path
