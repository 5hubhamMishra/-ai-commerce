# Template only — this file documents what production needs, but never holds real values
# and is never loaded directly. Real production secrets live in the cloud provider's secret
# manager (see docs/DEPLOYMENT.md) and are injected as runtime environment variables, never
# committed here.

NODE_ENV=production
PORT=4000
WEB_ORIGIN=https://your-production-domain.example

# Populate these only in the secret manager, never in source control:
DATABASE_URL=
DIRECT_URL=
REDIS_URL=
EMBEDDING_PROVIDER=hashing
OPENAI_API_KEY=
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL_DAYS=30
NEXT_PUBLIC_API_URL=
NEXT_PUBLIC_SITE_URL=
NEXT_PUBLIC_ALLOW_DEMO_FALLBACK=false
EXPO_PUBLIC_API_URL=
ANTHROPIC_API_KEY=
PAYMENT_SECRET=
CRON_SECRET=
# Real production checkout must use a configured provider; do not deploy the
# simulated development adapter for customer-facing payments.
PAYMENT_PROVIDER=razorpay
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
NEXT_PUBLIC_RAZORPAY_KEY_ID=
EXPO_PUBLIC_RAZORPAY_KEY_ID=
STORAGE_BUCKET=
