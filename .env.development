# Safe to commit: local-only values, ephemeral database, no real secrets.
# Matches infrastructure/docker/docker-compose.yml service credentials.

NODE_ENV=development
PORT=4000
# Comma-separated allow-list: npm run dev:web (3000) and apps/web's Playwright suite, which
# builds+serves its own instance on 3100 to avoid dev-mode compile latency (see
# apps/web/playwright.config.ts).
WEB_ORIGIN=http://localhost:3000,http://localhost:3100
DATABASE_URL=postgresql://ai_commerce:ai_commerce_dev@localhost:5432/ai_commerce?schema=public
DIRECT_URL=postgresql://ai_commerce:ai_commerce_dev@localhost:5432/ai_commerce?schema=public
REDIS_URL=redis://localhost:6379

# Dev-only signing keys — never reused in any shared or production environment.
JWT_ACCESS_SECRET=dev-access-secret-do-not-use-in-production-aaaaaaaaaaaaaaaa
JWT_ACCESS_TTL=15m
JWT_REFRESH_SECRET=dev-refresh-secret-do-not-use-in-production-bbbbbbbbbbbbbbbb
JWT_REFRESH_TTL_DAYS=30

# Verifies the (simulated) payment provider webhook's HMAC signature — see
# DevelopmentPaymentAdapter.verifyWebhookSignature. Dev-only value, never reused.
PAYMENT_SECRET=dev-payment-webhook-secret-do-not-use-in-production-eeeeeeeeeeee

NEXT_PUBLIC_API_URL=http://localhost:4000/api/v1
EXPO_PUBLIC_API_URL=http://localhost:4000/api/v1
