// AI-Commerce — Prisma schema
// Phase 1 (Foundation): identity, RBAC, profiles, addresses, audit, sessions.
// Phase 2 (Catalog): categories, brands, products, variants/SKUs, attributes,
// images, specifications, tags, warehouses, inventory.
// Commerce/marketplace/behavioral models are added in their own phases (see
// docs/DATABASE.md for the full target schema and phase mapping).

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  // DATABASE_URL is the pooled connection (Neon's PgBouncer-compatible pooler, needed for
  // serverless — a fresh connection per cold start would exhaust Postgres's real
  // connection limit under concurrent invocations). DIRECT_URL is Neon's unpooled
  // connection, required for `prisma migrate` (schema-changing DDL needs a direct
  // session, not one multiplexed through a pooler) — falls back to DATABASE_URL so local
  // dev against plain Docker Postgres (no pooler, one URL for everything) needs no change.
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum Role {
  CUSTOMER
  SELLER
  SELLER_STAFF
  SUPPORT_AGENT
  CONTENT_MANAGER
  INVENTORY_MANAGER
  ANALYST
  ADMIN
  SUPER_ADMIN
}

model User {
  id              String    @id @default(uuid())
  email           String    @unique
  passwordHash    String    @map("password_hash")
  name            String
  isActive        Boolean   @default(true) @map("is_active")
  emailVerifiedAt DateTime? @map("email_verified_at")
  createdAt       DateTime  @default(now()) @map("created_at")
  updatedAt       DateTime  @updatedAt @map("updated_at")
  deletedAt       DateTime? @map("deleted_at")

  roles                     UserRole[]
  profile                   Profile?
  addresses                 Address[]
  refreshTokens             RefreshToken[]
  auditLogs                 AuditLog[]                 @relation("ActorAuditLogs")
  cart                      Cart?
  wishlistItems             WishlistItem[]
  orders                    Order[]
  returnRequests            ReturnRequest[]
  notifications             Notification[]
  supportTickets            SupportTicket[]
  sentMessages              SupportMessage[]
  sellerAccount             Seller?                    @relation("SellerOwner")
  sellerStaffOf             SellerStaff[]              @relation("SellerStaffUser")
  sellerRatings             SellerRating[]             @relation("SellerRatingUser")
  sessions                  Session[]
  events                    BehavioralEvent[]
  customerProfile           CustomerProfile?
  recommendationImpressions RecommendationImpression[]
  searchQueryLogs           SearchQueryLog[]
  shopaiConversations       ShopAIConversation[]
  shopaiInteractionLogs     ShopAIInteractionLog[]

  @@map("users")
}

model UserRole {
  id     String @id @default(uuid())
  userId String @map("user_id")
  role   Role

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, role])
  @@map("user_roles")
}

model Profile {
  id                      String    @id @default(uuid())
  userId                  String    @unique @map("user_id")
  phone                   String?
  dateOfBirth             DateTime? @map("date_of_birth")
  personalizationEnabled  Boolean   @default(true) @map("personalization_enabled")
  notificationPreferences Json      @default("{}") @map("notification_preferences")
  createdAt               DateTime  @default(now()) @map("created_at")
  updatedAt               DateTime  @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("profiles")
}

model Address {
  id         String   @id @default(uuid())
  userId     String   @map("user_id")
  label      String?
  line1      String
  line2      String?
  city       String
  state      String
  postalCode String   @map("postal_code")
  country    String
  isDefault  Boolean  @default(false) @map("is_default")
  createdAt  DateTime @default(now()) @map("created_at")
  updatedAt  DateTime @updatedAt @map("updated_at")

  user   User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  orders Order[]

  @@index([userId])
  @@map("addresses")
}

// Refresh tokens are stored hashed, never in plaintext, so a database leak alone
// doesn't grant session hijacking. Enables real logout/revocation (spec: AUTHENTICATION).
model RefreshToken {
  id        String    @id @default(uuid())
  userId    String    @map("user_id")
  tokenHash String    @unique @map("token_hash")
  expiresAt DateTime  @map("expires_at")
  revokedAt DateTime? @map("revoked_at")
  createdAt DateTime  @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("refresh_tokens")
}

model AuditLog {
  id         String   @id @default(uuid())
  actorId    String?  @map("actor_id")
  action     String
  entityType String   @map("entity_type")
  entityId   String?  @map("entity_id")
  metadata   Json     @default("{}")
  createdAt  DateTime @default(now()) @map("created_at")

  actor User? @relation("ActorAuditLogs", fields: [actorId], references: [id], onDelete: SetNull)

  @@index([entityType, entityId])
  @@index([actorId])
  @@map("audit_logs")
}

// ---------------------------------------------------------------------------
// Phase 2 — Catalog
// ---------------------------------------------------------------------------

enum ProductStatus {
  DRAFT
  ACTIVE
  ARCHIVED
}

model Category {
  id               String    @id @default(uuid())
  name             String
  slug             String    @unique
  description      String?
  imageUrl         String?   @map("image_url")
  parentId         String?   @map("parent_id")
  sortOrder        Int       @default(0) @map("sort_order")
  isActive         Boolean   @default(true) @map("is_active")
  // Category-level override of the global default return window (see
  // config.returns.defaultWindowDays). Null means "use the global default."
  returnWindowDays Int?      @map("return_window_days")
  createdAt        DateTime  @default(now()) @map("created_at")
  updatedAt        DateTime  @updatedAt @map("updated_at")
  deletedAt        DateTime? @map("deleted_at")

  parent   Category?  @relation("CategoryHierarchy", fields: [parentId], references: [id], onDelete: SetNull)
  children Category[] @relation("CategoryHierarchy")
  products Product[]

  @@index([parentId])
  @@map("categories")
}

model Brand {
  id          String    @id @default(uuid())
  name        String
  slug        String    @unique
  description String?
  logoUrl     String?   @map("logo_url")
  isActive    Boolean   @default(true) @map("is_active")
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")
  deletedAt   DateTime? @map("deleted_at")

  products Product[]

  @@map("brands")
}

// A named attribute type usable across products for faceting/variant selection
// (e.g. "Color", "Storage"). Values are catalog-wide so the same "Red" can be
// reused across many products rather than re-typed per product.
model Attribute {
  id   String @id @default(uuid())
  name String
  slug String @unique

  values AttributeValue[]

  @@map("attributes")
}

model AttributeValue {
  id          String @id @default(uuid())
  attributeId String @map("attribute_id")
  value       String
  slug        String

  attribute Attribute               @relation(fields: [attributeId], references: [id], onDelete: Cascade)
  variants  VariantAttributeValue[]

  @@unique([attributeId, slug])
  @@map("attribute_values")
}

model Tag {
  id   String @id @default(uuid())
  name String
  slug String @unique

  products ProductTagAssignment[]

  @@map("tags")
}

// `sellerId` (Phase 5) is null for platform-owned products (the existing
// catalog) and set for marketplace seller listings — same table, same
// ProductsService CRUD/search/cache/event pipeline for both, so customer
// browse/search/cart/checkout code never needs to know or care which kind of
// product it's looking at (spec: "customers can purchase without being aware
// of unnecessary internal marketplace complexity" — see DECISIONS.md ADR-020).
model Product {
  id          String        @id @default(uuid())
  categoryId  String        @map("category_id")
  brandId     String?       @map("brand_id")
  sellerId    String?       @map("seller_id")
  name        String
  slug        String        @unique
  description String
  status      ProductStatus @default(DRAFT)
  isFeatured  Boolean       @default(false) @map("is_featured")
  createdAt   DateTime      @default(now()) @map("created_at")
  updatedAt   DateTime      @updatedAt @map("updated_at")
  deletedAt   DateTime?     @map("deleted_at")

  category                  Category                   @relation(fields: [categoryId], references: [id])
  brand                     Brand?                     @relation(fields: [brandId], references: [id])
  seller                    Seller?                    @relation(fields: [sellerId], references: [id])
  variants                  ProductVariant[]
  images                    ProductImage[]
  specifications            ProductSpecification[]
  tags                      ProductTagAssignment[]
  wishlistItems             WishlistItem[]
  embedding                 ProductEmbedding?
  recommendationImpressions RecommendationImpression[]

  @@index([categoryId])
  @@index([brandId])
  @@index([sellerId])
  @@index([status])
  @@map("products")
}

model ProductTagAssignment {
  productId String @map("product_id")
  tagId     String @map("tag_id")

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  tag     Tag     @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@id([productId, tagId])
  @@map("product_tag_assignments")
}

// One row per sellable SKU. "Variant" and "SKU" are the same entity here —
// every purchasable unit of a product is a ProductVariant with a unique `sku`.
model ProductVariant {
  id             String    @id @default(uuid())
  productId      String    @map("product_id")
  sku            String    @unique
  price          Decimal   @db.Decimal(12, 2)
  compareAtPrice Decimal?  @map("compare_at_price") @db.Decimal(12, 2)
  currency       String    @default("INR")
  weightGrams    Int?      @map("weight_grams")
  isDefault      Boolean   @default(false) @map("is_default")
  isActive       Boolean   @default(true) @map("is_active")
  createdAt      DateTime  @default(now()) @map("created_at")
  updatedAt      DateTime  @updatedAt @map("updated_at")
  deletedAt      DateTime? @map("deleted_at")

  product             Product                 @relation(fields: [productId], references: [id], onDelete: Cascade)
  attributeValues     VariantAttributeValue[]
  images              ProductImage[]
  inventory           Inventory[]
  cartItems           CartItem[]
  orderItems          OrderItem[]
  replacementItems    ReplacementItem[]
  exchangesAsOriginal Exchange[]              @relation("ExchangeOriginalVariant")
  exchangesAsNew      Exchange[]              @relation("ExchangeNewVariant")
  desiredForReturns   ReturnRequest[]         @relation("ReturnDesiredVariant")

  @@index([productId])
  @@map("product_variants")
}

model VariantAttributeValue {
  variantId        String @map("variant_id")
  attributeValueId String @map("attribute_value_id")

  variant        ProductVariant @relation(fields: [variantId], references: [id], onDelete: Cascade)
  attributeValue AttributeValue @relation(fields: [attributeValueId], references: [id], onDelete: Cascade)

  @@id([variantId, attributeValueId])
  @@map("variant_attribute_values")
}

model ProductImage {
  id        String   @id @default(uuid())
  productId String   @map("product_id")
  variantId String?  @map("variant_id")
  url       String
  altText   String?  @map("alt_text")
  sortOrder Int      @default(0) @map("sort_order")
  isPrimary Boolean  @default(false) @map("is_primary")
  createdAt DateTime @default(now()) @map("created_at")

  product Product         @relation(fields: [productId], references: [id], onDelete: Cascade)
  variant ProductVariant? @relation(fields: [variantId], references: [id], onDelete: Cascade)

  @@index([productId])
  @@index([variantId])
  @@map("product_images")
}

model ProductSpecification {
  id        String @id @default(uuid())
  productId String @map("product_id")
  group     String @default("General")
  key       String
  value     String
  sortOrder Int    @default(0) @map("sort_order")

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([productId])
  @@map("product_specifications")
}

// `sellerId` (Phase 5) is null for the platform's own fulfillment centers and
// set for a seller's own warehouse — a verified seller gets one auto-created
// by default (see SellersService), and can register more the same way an
// admin does, just ownership-scoped. Same deactivate-don't-delete rule
// (ADR-011) applies regardless of owner.
model Warehouse {
  id         String   @id @default(uuid())
  sellerId   String?  @map("seller_id")
  name       String
  code       String   @unique
  line1      String
  city       String
  state      String
  postalCode String   @map("postal_code")
  country    String
  isActive   Boolean  @default(true) @map("is_active")
  createdAt  DateTime @default(now()) @map("created_at")
  updatedAt  DateTime @updatedAt @map("updated_at")

  seller     Seller?     @relation(fields: [sellerId], references: [id])
  inventory  Inventory[]
  orderItems OrderItem[]

  @@index([sellerId])
  @@map("warehouses")
}

// Aggregate quantity buckets per (variant, warehouse) — not per-serial tracking.
// `available` is derived (onHand - reserved - committed), not stored, so it can
// never drift out of sync with the counts that define it.
model Inventory {
  id                String   @id @default(uuid())
  variantId         String   @map("variant_id")
  warehouseId       String   @map("warehouse_id")
  quantityOnHand    Int      @default(0) @map("quantity_on_hand")
  quantityReserved  Int      @default(0) @map("quantity_reserved")
  quantityCommitted Int      @default(0) @map("quantity_committed")
  quantityDamaged   Int      @default(0) @map("quantity_damaged")
  quantityIncoming  Int      @default(0) @map("quantity_incoming")
  reorderPoint      Int      @default(0) @map("reorder_point")
  updatedAt         DateTime @updatedAt @map("updated_at")

  variant   ProductVariant @relation(fields: [variantId], references: [id], onDelete: Cascade)
  warehouse Warehouse      @relation(fields: [warehouseId], references: [id], onDelete: Cascade)

  @@unique([variantId, warehouseId])
  @@map("inventory")
}

// ---------------------------------------------------------------------------
// Phase 3 — Core Commerce
//
// Coupons/promotions/gift cards/bundles/subscriptions are intentionally deferred
// (not in PROMPT 04's build list — see docs/DECISIONS.md ADR-012, which supersedes
// DATABASE.md's earlier forward-looking note in ADR-009).
// ---------------------------------------------------------------------------

enum OrderStatus {
  PENDING_PAYMENT
  PAID
  CONFIRMED
  PROCESSING
  PACKED
  SHIPPED
  OUT_FOR_DELIVERY
  DELIVERED
  CANCELLED
  RETURN_REQUESTED
  REFUND_PENDING
  REFUNDED
  RETURNED
  REPLACEMENT
  EXCHANGED
}

enum PaymentStatus {
  PENDING
  SUCCEEDED
  FAILED
  REFUNDED
  CANCELLED
}

enum PaymentProviderType {
  DEVELOPMENT
  RAZORPAY
  STRIPE
}

enum ShipmentStatus {
  PENDING
  DISPATCHED
  IN_TRANSIT
  DELIVERED
  FAILED
}

// One persistent cart per user, reused across sessions. Cleared (items deleted)
// on successful checkout, not recreated — never a source of truth for anything
// beyond "what's currently in the customer's cart" (spec: never Redis/ephemeral
// storage for critical commerce state; Postgres is authoritative here too).
model Cart {
  id        String   @id @default(uuid())
  userId    String   @unique @map("user_id")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  user  User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  items CartItem[]

  @@map("carts")
}

model CartItem {
  id        String   @id @default(uuid())
  cartId    String   @map("cart_id")
  variantId String   @map("variant_id")
  quantity  Int
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  cart    Cart           @relation(fields: [cartId], references: [id], onDelete: Cascade)
  variant ProductVariant @relation(fields: [variantId], references: [id], onDelete: Cascade)

  @@unique([cartId, variantId])
  @@map("cart_items")
}

// Wishlisted at product level (not variant), matching the existing frontend's
// model and typical customer intent ("I want this product", not one specific SKU).
model WishlistItem {
  id        String   @id @default(uuid())
  userId    String   @map("user_id")
  productId String   @map("product_id")
  createdAt DateTime @default(now()) @map("created_at")

  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@unique([userId, productId])
  @@map("wishlist_items")
}

// Orders are never deleted or soft-deleted — they're a permanent audit/financial
// record. Only `status` moves, and only through the explicit state machine in
// order-state-machine.ts (never an arbitrary frontend-set value).
model Order {
  id             String      @id @default(uuid())
  userId         String      @map("user_id")
  addressId      String      @map("address_id")
  status         OrderStatus @default(PENDING_PAYMENT)
  subtotal       Decimal     @db.Decimal(12, 2)
  shippingFee    Decimal     @default(0) @map("shipping_fee") @db.Decimal(12, 2)
  discountTotal  Decimal     @default(0) @map("discount_total") @db.Decimal(12, 2)
  taxTotal       Decimal     @default(0) @map("tax_total") @db.Decimal(12, 2)
  total          Decimal     @db.Decimal(12, 2)
  currency       String      @default("INR")
  shippingMethod String      @map("shipping_method")
  cancelReason   String?     @map("cancel_reason")
  cancelledAt    DateTime?   @map("cancelled_at")
  createdAt      DateTime    @default(now()) @map("created_at")
  updatedAt      DateTime    @updatedAt @map("updated_at")

  user           User                @relation(fields: [userId], references: [id])
  address        Address             @relation(fields: [addressId], references: [id])
  items          OrderItem[]
  stateHistory   OrderStateHistory[]
  payments       Payment[]
  shipment       Shipment?
  returnRequests ReturnRequest[]
  refunds        Refund[]
  replacements   Replacement[]
  exchanges      Exchange[]
  invoice        Invoice?
  supportTickets SupportTicket[]
  sellerRatings  SellerRating[]

  @@index([userId])
  @@index([status])
  @@map("orders")
}

// Snapshotted at order-creation time (productName/sku/unitPrice) so an order
// always shows what was actually bought — immune to later catalog price/name
// changes, and immune to the variant being soft-deleted afterward. `sellerId`
// (Phase 5) is the same kind of snapshot — copied from the variant's product
// at order-creation time so a "seller orders" query never needs to join
// through variant->product, and stays correct even if a product is ever
// reassigned to a different seller later. Null means a platform-owned item.
model OrderItem {
  id          String  @id @default(uuid())
  orderId     String  @map("order_id")
  variantId   String  @map("variant_id")
  warehouseId String  @map("warehouse_id")
  sellerId    String? @map("seller_id")
  productName String  @map("product_name")
  sku         String
  unitPrice   Decimal @map("unit_price") @db.Decimal(12, 2)
  quantity    Int
  lineTotal   Decimal @map("line_total") @db.Decimal(12, 2)
  currency    String  @default("INR")

  order              Order               @relation(fields: [orderId], references: [id], onDelete: Cascade)
  variant            ProductVariant      @relation(fields: [variantId], references: [id])
  warehouse          Warehouse           @relation(fields: [warehouseId], references: [id])
  seller             Seller?             @relation(fields: [sellerId], references: [id])
  returnRequestItems ReturnRequestItem[]
  earning            SellerEarning?

  @@index([orderId])
  @@index([sellerId])
  @@map("order_items")
}

model OrderStateHistory {
  id         String       @id @default(uuid())
  orderId    String       @map("order_id")
  fromStatus OrderStatus? @map("from_status")
  toStatus   OrderStatus  @map("to_status")
  changedBy  String?      @map("changed_by")
  note       String?
  createdAt  DateTime     @default(now()) @map("created_at")

  order Order @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@index([orderId])
  @@map("order_state_history")
}

// One row per payment attempt (a retried/failed attempt does not overwrite the
// previous one — full history preserved for reconciliation). idempotencyKey is
// unique per order so a client retry with the same key can never create a second
// concurrent attempt.
model Payment {
  id             String              @id @default(uuid())
  orderId        String              @map("order_id")
  provider       PaymentProviderType
  providerRef    String?             @map("provider_ref")
  // Razorpay's refund API operates on the payment id, not the order id providerRef holds
  // (populated at createIntent time, before a payment id exists) — set once confirmPayment
  // succeeds. Null for the dev adapter and for any payment that never reached confirmation.
  providerPaymentRef String?         @map("provider_payment_ref")
  status         PaymentStatus       @default(PENDING)
  amount         Decimal             @db.Decimal(12, 2)
  currency       String              @default("INR")
  idempotencyKey String              @map("idempotency_key")
  failureReason  String?             @map("failure_reason")
  createdAt      DateTime            @default(now()) @map("created_at")
  updatedAt      DateTime            @updatedAt @map("updated_at")

  order   Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  refunds Refund[]

  @@unique([orderId, idempotencyKey])
  @@index([orderId])
  @@map("payments")
}

// Created at order-creation time with the selected method/fee. Carrier/tracking
// fields plus the ShipmentEvent timeline are populated once the admin dispatches
// the order (Phase 4 — order tracking).
model Shipment {
  id             String         @id @default(uuid())
  orderId        String         @unique @map("order_id")
  method         String
  fee            Decimal        @db.Decimal(12, 2)
  currency       String         @default("INR")
  carrier        String?
  trackingNumber String?        @map("tracking_number")
  status         ShipmentStatus @default(PENDING)
  createdAt      DateTime       @default(now()) @map("created_at")
  updatedAt      DateTime       @updatedAt @map("updated_at")

  order  Order           @relation(fields: [orderId], references: [id], onDelete: Cascade)
  events ShipmentEvent[]

  @@map("shipments")
}

// A timestamped tracking-event timeline for a shipment — the granular history
// behind Shipment's current `status`/`trackingNumber` snapshot fields.
model ShipmentEvent {
  id          String              @id @default(uuid())
  shipmentId  String              @map("shipment_id")
  status      ShipmentEventStatus
  location    String?
  description String?
  occurredAt  DateTime            @default(now()) @map("occurred_at")

  shipment Shipment @relation(fields: [shipmentId], references: [id], onDelete: Cascade)

  @@index([shipmentId])
  @@map("shipment_events")
}

// Generic idempotency-key store, keyed per (user, operation scope, client key).
// A row is inserted as a "claim" before the operation runs (see IdempotencyService)
// so concurrent duplicate requests are blocked by the unique constraint itself,
// not by a check-then-act race.
model IdempotencyKey {
  id           String   @id @default(uuid())
  userId       String   @map("user_id")
  scope        String
  key          String
  statusCode   Int?     @map("status_code")
  responseBody Json?    @map("response_body")
  createdAt    DateTime @default(now()) @map("created_at")

  @@unique([userId, scope, key])
  @@map("idempotency_keys")
}

// ---------------------------------------------------------------------------
// Phase 4 — Post-Purchase
// ---------------------------------------------------------------------------

enum ReturnReason {
  DEFECTIVE
  WRONG_ITEM
  NOT_AS_DESCRIBED
  NO_LONGER_NEEDED
  BETTER_PRICE_FOUND
  OTHER
}

enum ReturnStatus {
  REQUESTED
  APPROVED
  REJECTED
  PICKUP_SCHEDULED
  PICKED_UP
  INSPECTING
  COMPLETED
  CANCELLED
}

enum ReturnResolution {
  REFUND
  REPLACEMENT
  EXCHANGE
}

enum RefundStatus {
  PENDING
  PROCESSING
  COMPLETED
  FAILED
}

enum ReplacementStatus {
  REQUESTED
  APPROVED
  SHIPPED
  DELIVERED
  CANCELLED
}

enum ExchangeStatus {
  REQUESTED
  APPROVED
  AWAITING_PAYMENT
  SHIPPED
  DELIVERED
  CANCELLED
}

enum ShipmentEventStatus {
  LABEL_CREATED
  PICKED_UP
  IN_TRANSIT
  OUT_FOR_DELIVERY
  DELIVERED
  FAILED_DELIVERY
  RETURNED_TO_SENDER
}

enum NotificationType {
  ORDER_STATUS
  PAYMENT
  RETURN
  REFUND
  REPLACEMENT
  EXCHANGE
  SUPPORT
  SYSTEM
}

enum TicketStatus {
  OPEN
  IN_PROGRESS
  RESOLVED
  CLOSED
}

enum TicketCategory {
  ORDER
  PAYMENT
  RETURN
  PRODUCT
  ACCOUNT
  OTHER
}

// One order-level return per attempt; a rejected/cancelled request doesn't block
// a fresh one, so this is 1:many against Order (enforced in service logic: at
// most one non-terminal ReturnRequest per order at a time), not a 1:1 relation.
// Line items reference specific OrderItems + quantities so restocking is accurate
// even when only some items in a multi-item order are being returned — the
// order's own top-level status still follows the single-track state diagram in
// DATABASE.md (an order can only be REFUNDED *or* REPLACEMENT *or* EXCHANGED,
// not a mix, matching the spec's own state machine shape).
model ReturnRequest {
  id               String           @id @default(uuid())
  orderId          String           @map("order_id")
  userId           String           @map("user_id")
  reason           ReturnReason
  reasonNote       String?          @map("reason_note")
  // Chosen by the customer at request time (matches typical "return or replace"
  // UX) — inspection can still reject the request outright, but doesn't re-pick
  // the resolution type.
  resolution       ReturnResolution
  // Only set when resolution = EXCHANGE.
  desiredVariantId String?          @map("desired_variant_id")
  status           ReturnStatus     @default(REQUESTED)
  rejectReason     String?          @map("reject_reason")
  createdAt        DateTime         @default(now()) @map("created_at")
  updatedAt        DateTime         @updatedAt @map("updated_at")

  order          Order               @relation(fields: [orderId], references: [id])
  user           User                @relation(fields: [userId], references: [id])
  desiredVariant ProductVariant?     @relation("ReturnDesiredVariant", fields: [desiredVariantId], references: [id])
  items          ReturnRequestItem[]
  refund         Refund?
  replacement    Replacement?
  exchange       Exchange?

  @@index([orderId])
  @@index([userId])
  @@map("return_requests")
}

model ReturnRequestItem {
  id              String  @id @default(uuid())
  returnRequestId String  @map("return_request_id")
  orderItemId     String  @map("order_item_id")
  quantity        Int
  // Set at inspection time (e.g. "sealed", "opened", "damaged") — informs the
  // approve/reject-on-inspection decision and whether stock is restockable.
  condition       String?

  returnRequest ReturnRequest @relation(fields: [returnRequestId], references: [id], onDelete: Cascade)
  orderItem     OrderItem     @relation(fields: [orderItemId], references: [id])

  @@index([returnRequestId])
  @@map("return_request_items")
}

// One row per refund attempt, linked to both the order and the specific payment
// being refunded against (a refund can never exceed what was actually paid).
// `returnRequestId` is null for a refund issued without a return (e.g. a
// goodwill/cancellation refund) — most refunds do originate from a return, but
// the relation isn't mandatory.
model Refund {
  id              String       @id @default(uuid())
  orderId         String       @map("order_id")
  paymentId       String       @map("payment_id")
  returnRequestId String?      @unique @map("return_request_id")
  amount          Decimal      @db.Decimal(12, 2)
  currency        String       @default("INR")
  reason          String
  status          RefundStatus @default(PENDING)
  providerRef     String?      @map("provider_ref")
  failureReason   String?      @map("failure_reason")
  createdAt       DateTime     @default(now()) @map("created_at")
  updatedAt       DateTime     @updatedAt @map("updated_at")

  order         Order          @relation(fields: [orderId], references: [id])
  payment       Payment        @relation(fields: [paymentId], references: [id])
  returnRequest ReturnRequest? @relation(fields: [returnRequestId], references: [id])

  @@index([orderId])
  @@index([paymentId])
  @@map("refunds")
}

// A replacement shipment for the same item(s), issued instead of a refund.
// Tracks its own dispatch state independent of the original order's (terminal)
// status.
model Replacement {
  id              String            @id @default(uuid())
  returnRequestId String            @unique @map("return_request_id")
  orderId         String            @map("order_id")
  status          ReplacementStatus @default(REQUESTED)
  trackingNumber  String?           @map("tracking_number")
  carrier         String?
  createdAt       DateTime          @default(now()) @map("created_at")
  updatedAt       DateTime          @updatedAt @map("updated_at")

  returnRequest ReturnRequest     @relation(fields: [returnRequestId], references: [id])
  order         Order             @relation(fields: [orderId], references: [id])
  items         ReplacementItem[]

  @@map("replacements")
}

model ReplacementItem {
  id            String @id @default(uuid())
  replacementId String @map("replacement_id")
  variantId     String @map("variant_id")
  quantity      Int

  replacement Replacement    @relation(fields: [replacementId], references: [id], onDelete: Cascade)
  variant     ProductVariant @relation(fields: [variantId], references: [id])

  @@index([replacementId])
  @@map("replacement_items")
}

// Swaps one variant for another. `priceDifference` is (new price - original
// price) * quantity — positive means the customer owes more (settled via a new
// Payment), negative means money is owed back (settled via a Refund). Reuses
// the existing payment/refund abstractions rather than inventing new payment
// mechanics for this one flow.
model Exchange {
  id                String         @id @default(uuid())
  returnRequestId   String         @unique @map("return_request_id")
  orderId           String         @map("order_id")
  originalVariantId String         @map("original_variant_id")
  newVariantId      String         @map("new_variant_id")
  quantity          Int
  priceDifference   Decimal        @default(0) @map("price_difference") @db.Decimal(12, 2)
  status            ExchangeStatus @default(REQUESTED)
  trackingNumber    String?        @map("tracking_number")
  carrier           String?
  createdAt         DateTime       @default(now()) @map("created_at")
  updatedAt         DateTime       @updatedAt @map("updated_at")

  returnRequest   ReturnRequest  @relation(fields: [returnRequestId], references: [id])
  order           Order          @relation(fields: [orderId], references: [id])
  originalVariant ProductVariant @relation("ExchangeOriginalVariant", fields: [originalVariantId], references: [id])
  newVariant      ProductVariant @relation("ExchangeNewVariant", fields: [newVariantId], references: [id])

  @@map("exchanges")
}

// `sequenceNumber` is a Postgres-native autoincrement column — the atomic,
// race-free source of invoice-number uniqueness (its value isn't known until
// the row is actually inserted, so it can't be precomputed into a second
// column without a two-phase write). The display string (e.g. "INV-2026-000123")
// is derived from it at read time instead — trivial to compute, so persisting a
// separately-written copy would only add a race window for no real benefit.
// Invoice content itself (line items, totals, addresses) is not duplicated
// here either — it's rendered from Order/OrderItem/Address at request time, so
// it can never drift from the order it describes.
model Invoice {
  id             String   @id @default(uuid())
  orderId        String   @unique @map("order_id")
  sequenceNumber Int      @default(autoincrement()) @map("sequence_number")
  issuedAt       DateTime @default(now()) @map("issued_at")

  order Order @relation(fields: [orderId], references: [id])

  @@map("invoices")
}

// Real in-app notification center — written to by order/return/refund/support
// domain-event listeners (see EVENTS.md). External channels (email/SMS/push)
// are a documented gap: they need a provider integration this phase doesn't
// add, same "adapter later, dev-mode now" precedent as payments/shipping.
model Notification {
  id          String           @id @default(uuid())
  userId      String           @map("user_id")
  type        NotificationType
  title       String
  body        String
  relatedType String?          @map("related_type")
  relatedId   String?          @map("related_id")
  readAt      DateTime?        @map("read_at")
  createdAt   DateTime         @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("notifications")
}

model SupportTicket {
  id        String         @id @default(uuid())
  userId    String         @map("user_id")
  orderId   String?        @map("order_id")
  subject   String
  category  TicketCategory
  status    TicketStatus   @default(OPEN)
  createdAt DateTime       @default(now()) @map("created_at")
  updatedAt DateTime       @updatedAt @map("updated_at")

  user     User             @relation(fields: [userId], references: [id])
  order    Order?           @relation(fields: [orderId], references: [id])
  messages SupportMessage[]

  @@index([userId])
  @@index([status])
  @@map("support_tickets")
}

model SupportMessage {
  id           String   @id @default(uuid())
  ticketId     String   @map("ticket_id")
  senderId     String   @map("sender_id")
  isStaffReply Boolean  @default(false) @map("is_staff_reply")
  body         String
  createdAt    DateTime @default(now()) @map("created_at")

  ticket SupportTicket @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  sender User          @relation(fields: [senderId], references: [id])

  @@index([ticketId])
  @@map("support_messages")
}

// Admin-managed help-center content — same CMS-like shape as catalog content
// (categories/brands): simple flat article model, no versioning/workflow.
model HelpArticle {
  id          String   @id @default(uuid())
  slug        String   @unique
  title       String
  body        String
  category    String
  sortOrder   Int      @default(0) @map("sort_order")
  isPublished Boolean  @default(true) @map("is_published")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  @@map("help_articles")
}

// Phase 5 — Marketplace

enum SellerStatus {
  PENDING_VERIFICATION
  VERIFIED
  REJECTED
  SUSPENDED
}

enum PayoutStatus {
  PENDING
  PROCESSING
  PAID
  FAILED
}

// One seller account per user (`ownerUserId` unique) — a user who wants a
// second storefront needs a second account, matching how most real
// marketplaces (Amazon, Etsy) scope seller identity to a single owner rather
// than letting one person operate several under one login. `commissionRateBps`
// is basis points (1000 = 10%) to avoid float rounding on money math, snapshot
// onto each SellerEarning at order-creation time so a later platform-wide rate
// change never retroactively changes what a seller earned on a past sale.
model Seller {
  id                String       @id @default(uuid())
  ownerUserId       String       @unique @map("owner_user_id")
  businessName      String       @map("business_name")
  slug              String       @unique
  description       String?
  logoUrl           String?      @map("logo_url")
  bannerUrl         String?      @map("banner_url")
  status            SellerStatus @default(PENDING_VERIFICATION)
  commissionRateBps Int          @default(1000) @map("commission_rate_bps")
  rejectReason      String?      @map("reject_reason")
  suspendReason     String?      @map("suspend_reason")
  verifiedAt        DateTime?    @map("verified_at")
  createdAt         DateTime     @default(now()) @map("created_at")
  updatedAt         DateTime     @updatedAt @map("updated_at")

  owner      User            @relation("SellerOwner", fields: [ownerUserId], references: [id])
  staff      SellerStaff[]
  products   Product[]
  warehouses Warehouse[]
  orderItems OrderItem[]
  earnings   SellerEarning[]
  payouts    SellerPayout[]
  ratings    SellerRating[]

  @@index([status])
  @@map("sellers")
}

// A seller "account" can have more than one human operating it (owner +
// staff) — mirrors how User/UserRole already separates identity from granted
// capability, just scoped to one seller instead of the whole platform.
model SellerStaff {
  id        String   @id @default(uuid())
  sellerId  String   @map("seller_id")
  userId    String   @map("user_id")
  isOwner   Boolean  @default(false) @map("is_owner")
  createdAt DateTime @default(now()) @map("created_at")

  seller Seller @relation(fields: [sellerId], references: [id], onDelete: Cascade)
  user   User   @relation("SellerStaffUser", fields: [userId], references: [id], onDelete: Cascade)

  @@unique([sellerId, userId])
  @@map("seller_staff")
}

// One row per marketplace order item, created alongside it at checkout —
// `grossAmount`/`commissionAmount`/`netAmount`/`commissionRateBps` are all
// snapshots (same ADR-016 philosophy as OrderItem's own product/price
// snapshot fields), immune to the seller's rate changing later. Deliberately
// has no stored status column: "available for payout" is derived at read
// time from the underlying order's current status (DELIVERED) rather than
// written by an event listener into this table — avoids adding any new hook
// into Phase 3/4's already-verified order-status-transition code, and
// matches the project's existing "derive on read, don't store what can
// drift" precedent (Inventory.available, Invoice's display number). Only
// `payoutId` is a real, service-owned write — set once this earning is
// actually included in a payout batch.
model SellerEarning {
  id                String   @id @default(uuid())
  sellerId          String   @map("seller_id")
  orderItemId       String   @unique @map("order_item_id")
  grossAmount       Decimal  @map("gross_amount") @db.Decimal(12, 2)
  commissionRateBps Int      @map("commission_rate_bps")
  commissionAmount  Decimal  @map("commission_amount") @db.Decimal(12, 2)
  netAmount         Decimal  @map("net_amount") @db.Decimal(12, 2)
  currency          String   @default("INR")
  payoutId          String?  @map("payout_id")
  createdAt         DateTime @default(now()) @map("created_at")

  seller    Seller        @relation(fields: [sellerId], references: [id])
  orderItem OrderItem     @relation(fields: [orderItemId], references: [id])
  payout    SellerPayout? @relation(fields: [payoutId], references: [id])

  @@index([sellerId])
  @@index([payoutId])
  @@map("seller_earnings")
}

// A batch payout of a seller's earned-but-unpaid net earnings, created by an
// admin action (POST /sellers/admin/:id/payouts) that atomically sums every
// eligible SellerEarning, calls the payout provider abstraction, and links
// the earnings it covers — mirroring Phase 3's payment-provider-abstraction
// shape (interface + injection token + dev adapter only; see ADR-015).
model SellerPayout {
  id            String       @id @default(uuid())
  sellerId      String       @map("seller_id")
  amount        Decimal      @db.Decimal(12, 2)
  currency      String       @default("INR")
  status        PayoutStatus @default(PENDING)
  providerRef   String?      @map("provider_ref")
  failureReason String?      @map("failure_reason")
  createdAt     DateTime     @default(now()) @map("created_at")
  updatedAt     DateTime     @updatedAt @map("updated_at")

  seller   Seller          @relation(fields: [sellerId], references: [id])
  earnings SellerEarning[]

  @@index([sellerId])
  @@map("seller_payouts")
}

// A customer's rating of a seller, tied to a specific delivered order so it
// can't be left before anything was actually fulfilled — one rating per
// (seller, order), not per product, matching "seller ratings" (not "product
// reviews", which this phase doesn't build) as PROMPT 06 literally asks for.
model SellerRating {
  id        String   @id @default(uuid())
  sellerId  String   @map("seller_id")
  userId    String   @map("user_id")
  orderId   String   @map("order_id")
  rating    Int
  comment   String?
  createdAt DateTime @default(now()) @map("created_at")

  seller Seller @relation(fields: [sellerId], references: [id])
  user   User   @relation("SellerRatingUser", fields: [userId], references: [id])
  order  Order  @relation(fields: [orderId], references: [id])

  @@unique([sellerId, orderId])
  @@index([sellerId])
  @@map("seller_ratings")
}

// Phase 6 — Behavioral Data Foundation

enum EventSource {
  WEB
  MOBILE
  BACKEND
}

// Union of apps/web's original 14 event types (already firing from real UI
// actions pre-Phase-1) and the spec's target list — additive, not a
// replacement, matching EVENTS.md's existing "current 14 -> adds 12 more"
// framing from the Phase 0 analysis.
enum BehavioralEventType {
  PRODUCT_VIEWED
  PRODUCT_CLICKED
  PRODUCT_SEARCHED
  PRODUCT_COMPARED
  PRODUCT_WISHLISTED
  PRODUCT_REMOVED_FROM_WISHLIST
  PRODUCT_ADDED_TO_CART
  PRODUCT_REMOVED_FROM_CART
  CHECKOUT_STARTED
  ORDER_COMPLETED
  CATEGORY_VIEWED
  FILTER_USED
  AI_ASSISTANT_QUERY
  RECOMMENDATION_CLICKED
  USER_REGISTERED
  USER_LOGIN
  SEARCH_FILTER_USED
  SEARCH_SORT_USED
  PAYMENT_STARTED
  PAYMENT_COMPLETED
  PRODUCT_REVIEWED
  RECOMMENDATION_VIEWED
  RECOMMENDATION_PURCHASED
  AI_ASSISTANT_PRODUCT_CLICKED
  RETURN_REQUESTED
  REFUND_COMPLETED
}

// A visit, not a person — `anonymousId` is the longer-lived, client-generated
// identifier (one per browser/device, persisted client-side) that survives
// across many sessions; `id` (the sessionId) rotates. `userId` is null until
// the visitor logs in, then set — the moment behavioral history starts being
// attributable to an identity rather than just a device. Upserted by the
// event collector on first contact, not created via a separate "start
// session" call the client would have to remember to make first.
model Session {
  id          String      @id @default(uuid())
  anonymousId String      @map("anonymous_id")
  userId      String?     @map("user_id")
  source      EventSource @default(WEB)
  startedAt   DateTime    @default(now()) @map("started_at")
  lastSeenAt  DateTime    @default(now()) @map("last_seen_at")

  user   User?             @relation(fields: [userId], references: [id])
  events BehavioralEvent[]

  @@index([anonymousId])
  @@index([userId])
  @@map("sessions")
}

// Append-only. `id` is the eventId and is CLIENT-supplied (not
// @default(uuid())) — duplicate prevention relies on a retry reusing the
// same id and hitting this table's primary-key uniqueness, the exact same
// "let the database's own constraint be the source of truth" pattern
// IdempotencyService already established (ADR-013), not a separate
// dedup-check read. `occurredAt` is client-supplied (when it actually
// happened, e.g. offline-then-synced mobile events); `receivedAt` is
// server-side, for reliability auditing (how far behind is ingestion
// running). No raw IP/user-agent columns — "do not unnecessarily store
// sensitive information" (spec) is a schema decision here, not just a
// policy note. `processedAt` is set once the aggregation queue worker has
// applied this event to a CustomerProfile — the guard that makes queue
// redelivery (BullMQ is at-least-once, not exactly-once) idempotent, so a
// retried/redelivered job can never double-count the same event.
model BehavioralEvent {
  id            String              @id
  eventType     BehavioralEventType @map("event_type")
  userId        String?             @map("user_id")
  anonymousId   String              @map("anonymous_id")
  sessionId     String              @map("session_id")
  source        EventSource
  entityId      String?             @map("entity_id")
  metadata      Json                @default("{}")
  schemaVersion Int                 @default(1) @map("schema_version")
  occurredAt    DateTime            @map("occurred_at")
  receivedAt    DateTime            @default(now()) @map("received_at")
  processedAt   DateTime?           @map("processed_at")

  user    User?   @relation(fields: [userId], references: [id])
  session Session @relation(fields: [sessionId], references: [id])

  @@index([userId])
  @@index([anonymousId])
  @@index([sessionId])
  @@index([eventType])
  @@map("behavioral_events")
}

// A deliberately simple v1: raw counters/aggregates only (view/cart/purchase
// counts per category and brand, observed price range, event/order counts).
// `segment`/`lifecycleStage` are plain strings computed from those counters
// by a small, documented heuristic function at read time — genuinely
// derived, never a hardcoded enum assignment (spec: "Do not permanently
// hard-code customer segments"). Real behavioral scoring, time decay, and
// cold-start handling are explicitly Phase 7's job (PROMPT 08) — this phase
// only has to lay a real, working foundation under it, not build the
// sophisticated version itself (same "don't half-build the next phase's
// job" precedent as every prior phase). One profile per identity: keyed by
// `userId` once known, falling back to `anonymousId` pre-login — never both
// null (enforced in `CustomerProfileService`, not a DB constraint, since
// Prisma has no portable partial-unique/check-constraint primitive for
// exactly-one-of-two-columns without dropping to raw SQL for a rule this
// easy to enforce in application code).
model CustomerProfile {
  id                     String    @id @default(uuid())
  userId                 String?   @unique @map("user_id")
  anonymousId            String?   @unique @map("anonymous_id")
  categoryViewCounts     Json      @default("{}") @map("category_view_counts")
  categoryCartCounts     Json      @default("{}") @map("category_cart_counts")
  categoryPurchaseCounts Json      @default("{}") @map("category_purchase_counts")
  brandViewCounts        Json      @default("{}") @map("brand_view_counts")
  priceObservedMin       Decimal?  @map("price_observed_min") @db.Decimal(12, 2)
  priceObservedMax       Decimal?  @map("price_observed_max") @db.Decimal(12, 2)
  eventCount             Int       @default(0) @map("event_count")
  orderCount             Int       @default(0) @map("order_count")
  firstSeenAt            DateTime  @default(now()) @map("first_seen_at")
  lastEventAt            DateTime? @map("last_event_at")
  updatedAt              DateTime  @updatedAt @map("updated_at")

  user User? @relation(fields: [userId], references: [id])

  @@map("customer_profiles")
}

// Phase 7 — AI Recommendations

// Only one model exists this phase: a deterministic feature-hashing embedding
// (see EmbeddingProvider), not a hosted ML model — no external AI provider is
// wired up anywhere in this codebase yet, and introducing one is a bigger,
// separate decision than this phase needs to make just to satisfy "product
// similarity." Phase 8 (semantic search) is free to add a second value here
// (a real hosted embedding model) behind the same provider interface without
// this table's shape changing — see DECISIONS.md ADR-023.
enum EmbeddingModel {
  HASHING_V1
}

// Real pgvector column since Phase 8 (was a plain `double precision[]` through
// Phase 7 — see ADR-023/ADR-024). `Unsupported()` because Prisma Client has no
// native vector type; every read/write against `embedding` goes through raw
// SQL in EmbeddingsService, the same "raw SQL where the ORM can't reach"
// precedent search.service.ts already used for price aggregation. An HNSW
// cosine-ops index backs nearest-neighbor queries (migration
// 20260818_phase8_semantic_search) — still genuinely optional at 112
// products, but real infrastructure the spec explicitly scoped to this
// phase, not deferred further.
model ProductEmbedding {
  id        String                       @id @default(uuid())
  productId String                       @unique @map("product_id")
  embedding Unsupported("vector(64)")?
  model     EmbeddingModel               @default(HASHING_V1)
  updatedAt DateTime                     @updatedAt @map("updated_at")

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@map("product_embeddings")
}

enum RecommendationContext {
  HOMEPAGE
  SIMILAR_PRODUCTS
  FREQUENTLY_BOUGHT_WITH
  TRENDING
}

// One row per product shown in a recommendation response — the "recommendation
// caching" the spec asks for isn't just a Redis TTL on the response (though
// there's that too, see RecommendationsService); it's this durable record of
// what was actually shown to whom, which is what makes the evaluation
// framework's CTR/conversion metrics real rather than invented. Correlated
// after the fact against RECOMMENDATION_CLICKED/RECOMMENDATION_PURCHASED
// BehavioralEvents (already real types since Phase 6) by matching
// (identity, productId) — see EvaluationService and DATABASE.md.
model RecommendationImpression {
  id          String                @id @default(uuid())
  userId      String?               @map("user_id")
  anonymousId String?               @map("anonymous_id")
  productId   String                @map("product_id")
  context     RecommendationContext
  position    Int
  reason      String
  createdAt   DateTime              @default(now()) @map("created_at")

  user    User?   @relation(fields: [userId], references: [id])
  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([anonymousId])
  @@index([productId])
  @@index([createdAt])
  @@map("recommendation_impressions")
}

// Search analytics (PROMPT 09's own "search analytics" bullet) — one row per
// search request, keyword-only or natural-language. `filters` snapshots the
// *effective* filters actually applied (explicit query params merged with
// whatever RuleBasedQueryUnderstandingAdapter extracted from free text, with
// explicit params winning ties) so a top-queries/zero-result report can be
// built without re-deriving anything. No FK-cascade concern here the way
// orders/returns have — a deleted user's past searches are just historical
// aggregate data, not a record anyone needs to keep pointing at a live row.
model SearchQueryLog {
  id           String   @id @default(uuid())
  query        String
  filters      Json
  resultCount  Int      @map("result_count")
  usedSemantic Boolean  @map("used_semantic")
  userId       String?  @map("user_id")
  anonymousId  String?  @map("anonymous_id")
  createdAt    DateTime @default(now()) @map("created_at")

  user User? @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([userId])
  @@index([anonymousId])
  @@index([createdAt])
  @@map("search_query_logs")
}

enum ChatRole {
  USER
  ASSISTANT
}

// One conversation belongs to exactly one identity, set at creation — same
// nullable-pair identity shape as everywhere else in this codebase
// (BehavioralEvent, RecommendationImpression, SearchQueryLog). Every
// read/continue against a conversationId must verify the caller's identity
// matches this row (IDOR check) before touching ShopAIMessage — this is the
// first place in the codebase where a caller supplies an existing record ID
// to *continue*, not just to read back their own aggregate history, so the
// check is load-bearing, not incidental.
model ShopAIConversation {
  id          String   @id @default(uuid())
  userId      String?  @map("user_id")
  anonymousId String?  @map("anonymous_id")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  user     User?           @relation(fields: [userId], references: [id], onDelete: SetNull)
  messages ShopAIMessage[]

  @@index([userId])
  @@index([anonymousId])
  @@map("shopai_conversations")
}

// Plain final text per turn — not the raw Anthropic content-block stream.
// Within one HTTP request, ShopAIService's tool-calling loop works with the
// full provider-native turn structure (assistant tool_use, user tool_result)
// entirely in memory; only the customer's own message and the assistant's
// final synthesized reply are persisted as conversation history, replayed
// as plain user/assistant text turns on the next request. `toolCalls` is an
// observability-only record of what ran this turn (name + input), never
// replayed into a future prompt — see AI_ARCHITECTURE.md.
model ShopAIMessage {
  id             String   @id @default(uuid())
  conversationId String   @map("conversation_id")
  role           ChatRole
  content        String   @db.Text
  toolCalls      Json?    @map("tool_calls")
  createdAt      DateTime @default(now()) @map("created_at")

  conversation ShopAIConversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  @@index([conversationId])
  @@map("shopai_messages")
}

// One row per assistant turn (not per tool call) — the "AI observability"
// PROMPT 10 asks for. Deliberately separate from ShopAIMessage: this is
// operational telemetry (cost/latency/safety monitoring), not conversation
// content, and has its own retention/analysis shape (aggregate reporting,
// same "log first, analyze later" pattern as SearchQueryLog/
// RecommendationImpression).
model ShopAIInteractionLog {
  id             String   @id @default(uuid())
  conversationId String   @map("conversation_id")
  userId         String?  @map("user_id")
  anonymousId    String?  @map("anonymous_id")
  model          String
  inputTokens    Int      @map("input_tokens")
  outputTokens   Int      @map("output_tokens")
  toolCallCount  Int      @map("tool_call_count")
  toolNames      String[] @map("tool_names")
  latencyMs      Int      @map("latency_ms")
  stopReason     String   @map("stop_reason")
  refused        Boolean  @default(false)
  createdAt      DateTime @default(now()) @map("created_at")

  user User? @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([conversationId])
  @@index([userId])
  @@index([createdAt])
  @@map("shopai_interaction_logs")
}
