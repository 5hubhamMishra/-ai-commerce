# Safe to commit: used only by the automated test suite (unit/integration/e2e), never by
# a running dev server. A separate database name keeps test runs from touching dev data.

NODE_ENV=test
PORT=4001
WEB_ORIGIN=http://localhost:3000
DATABASE_URL=postgresql://ai_commerce:ai_commerce_dev@localhost:5432/ai_commerce_test?schema=public
REDIS_URL=redis://localhost:6379/1

JWT_ACCESS_SECRET=test-access-secret-do-not-use-in-production-cccccccccccccccc
JWT_ACCESS_TTL=15m
JWT_REFRESH_SECRET=test-refresh-secret-do-not-use-in-production-dddddddddddddddd
JWT_REFRESH_TTL_DAYS=30
